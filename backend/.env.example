# ============================================================================
# Interview Assistant - Environment Configuration Template
# ============================================================================
# IMPORTANT: This is a template file. DO NOT commit actual secrets here.
# Copy this file to .env and fill in your actual values.
# The .env file is in .gitignore and will NOT be committed to git.
# ============================================================================

# 🔑 Google Gemini API Configuration
# Get your API key from: https://ai.google.dev/
# DO NOT share this key or commit it to version control
GOOGLE_API_KEY=AQ.Ab8RN6J854Ax4WQB9-qMQ2GjtSoqfiBKYRz1YzbXqfUqPHa4Gw

# 🤖 Embedding Model
# Model used for generating text embeddings
EMBEDDING_MODEL=models/embedding-001

# 🗄️ PostgreSQL Database Configuration (Optional - for Agent 2)
# Format: postgresql://username:password@host:port/database
# Example: postgresql://postgres:password@localhost:5432/interview_assistant
DATABASE_URL=postgresql://user:password@localhost:5432/interview_assistant

# 📦 Redis Configuration (Optional - for caching)
# Format: redis://host:port/database
REDIS_URL=redis://localhost:6379/0

# 🌐 CORS Origins
# Comma-separated list of allowed origins for frontend requests
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# 🌍 Application Environment
# Options: development, staging, production
ENVIRONMENT=development

# 🔍 Vector Store Configuration
# Path to FAISS index directory
FAISS_INDEX_PATH=./data/faiss_index

# 📊 Vector Dimension
# Dimension of embeddings (Gemini embedding-001 uses 768)
VECTOR_DIMENSION=768

# 📝 Chunking Configuration
# Size of text chunks for processing
CHUNK_SIZE=500

# 🔗 Chunk Overlap
# Overlap between consecutive chunks
CHUNK_OVERLAP=50

# 🎯 Similarity Threshold
# Minimum similarity score for shortlisting (0.0 to 1.0)
SIMILARITY_THRESHOLD=0.80

# 🔐 Security Settings
# Set to true in production
DEBUG=false

# ============================================================================
# SETUP INSTRUCTIONS
# ============================================================================
# 1. Copy this file: cp .env.example .env
# 2. Edit .env and fill in your actual values
# 3. NEVER commit .env to git
# 4. NEVER share your API keys
# 5. Verify .env is in .gitignore
# ============================================================================
